<idea-plugin>
    <id>cn.com.wewell.ai-code-assistant</id>
    <name>大鱼AI编程助手</name>
    <vendor url="http://www.wewell.com.cn">WeWell</vendor>
    <description>
        <![CDATA[
        大鱼AI编程助手（Dayu AI Coding Assistant）用于在 IntelliJ IDEA 中快速收集上下文、生成提示词并应用 AI 返回的代码变更。
        <br>
        <em>most HTML tags may be used</em>
      ]]>
    </description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>Git4Idea</depends>
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="cn.com.wewell.aicodeassistant.service.PromptManager"/>
        <projectService serviceImplementation="cn.com.wewell.aicodeassistant.service.ChangeApplierService"/>
        <projectService serviceImplementation="cn.com.wewell.aicodeassistant.service.DiffPresentationService"/>
        <projectService serviceImplementation="cn.com.wewell.aicodeassistant.service.HistoryManager"/>
        <projectService serviceImplementation="cn.com.wewell.aicodeassistant.service.AssistantConfigService"/>
        <!-- 工具窗口 -->
        <toolWindow id="大鱼AI编程助手"
                    anchor="right"
                    factoryClass="cn.com.wewell.aicodeassistant.ui.AssistantToolWindowFactory"
                    icon="/pluginIcon.svg"/>

        <!-- 通知组 -->
        <notificationGroup id="Dayu AI Coding Assistant Notifications"
                           displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- 编辑器右键菜单 -->
        <action id="AddToAIAssistant"
                class="cn.com.wewell.aicodeassistant.action.AddToAssistantAction"
                text="添加到大鱼AI编程助手"
                description="将选中的代码添加到大鱼AI编程助手">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default"
                               first-keystroke="ctrl shift A"/>
        </action>
        <action id="AIAssistant.AddFilesToAssistant"
                class="cn.com.wewell.aicodeassistant.action.AddFilesToAssistantAction"
                text="添加到大鱼AI编程助手"
                description="将选中的文件或目录添加到大鱼AI编程助手">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="AddToAIAssistant"/>
        </action>

        <!-- 紧凑模式：以结构/签名为主，控制上下文体量 -->
        <action id="AIAssistant.AddCompactFilesToAssistant"
                class="cn.com.wewell.aicodeassistant.action.AddCompactFilesToAssistantAction"
                text="添加到大鱼AI编程助手（紧凑）"
                description="以紧凑模式添加选中文件/目录到大鱼AI编程助手">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="AIAssistant.AddFilesToAssistant"/>
        </action>

        <!-- 工具窗口的 Action Group -->
        <group id="AIAssistant.ToolWindowActions" popup="false">
            <action id="AIAssistant.GeneratePrompt"
                    class="cn.com.wewell.aicodeassistant.action.toolwindow.GeneratePromptAction"
                    text="生成提示词" description="将当前内容包装成完整的AI提示词" icon="AllIcons.Actions.Execute"/>
            <action id="AIAssistant.GenerateProjectTree"
                    class="cn.com.wewell.aicodeassistant.action.toolwindow.GenerateProjectTreeAction"
                    text="目录结构" description="生成项目目录结构树" icon="AllIcons.Actions.ProjectDirectory"/>
            <action id="AIAssistant.CopyPrompt"
                    class="cn.com.wewell.aicodeassistant.action.toolwindow.CopyPromptAction"
                    text="复制" description="复制输入区内容到剪贴板" icon="AllIcons.Actions.Copy"/>
            <action id="AIAssistant.PasteResponse"
                    class="cn.com.wewell.aicodeassistant.action.toolwindow.PasteResponseAction"
                    text="粘贴" description="从剪贴板粘贴AI响应" icon="AllIcons.Actions.MenuPaste"/>
            <action id="AIAssistant.ParseResponse"
                    class="cn.com.wewell.aicodeassistant.action.toolwindow.ParseResponseAction"
                    text="解析" description="解析AI响应并预览变更" icon="AllIcons.Actions.Find"/>
            <action id="AIAssistant.ClearAll"
                    class="cn.com.wewell.aicodeassistant.action.toolwindow.ClearAllAction"
                    text="清空" description="清空所有内容" icon="AllIcons.Actions.GC"/>
            <action id="AIAssistant.RefreshConfig"
                    class="cn.com.wewell.aicodeassistant.action.toolwindow.RefreshAssistantConfigAction"
                    text="刷新配置" description="重新加载 .ai-assistant/config.json 配置"
                    icon="AllIcons.Actions.Refresh"/>
        </group>
    </actions>
</idea-plugin>
